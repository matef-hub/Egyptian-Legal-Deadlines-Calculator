<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.EgyptianLegalDeadlines" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0F2027</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F2027</item>
    </style>

    <!-- Native Splash Screen Theme using AndroidX SplashScreen API -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F2027</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.EgyptianLegalDeadlines</item>
        <item name="android:statusBarColor">#0F2027</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F2027</item>
    </style>
</resources>
